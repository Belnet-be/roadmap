gem "validates_hostname"
gem "rails_admin", '~> 3.1.2'
gem "file_utils"
# rails_admin needs this because of change rails change to sprockets
gem "sassc-rails", group: :development

# fix logger problem
gem 'concurrent-ruby', '1.3.4'

# net-pop removed from dependencies for gem mail since ruby 3.3.3 (but still requested at runtime)
# cf. https://github.com/rubygems/rubygems/issues/7760
gem 'net-pop'
gem 'net-imap'
