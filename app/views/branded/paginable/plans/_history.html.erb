<div class="table-responsive" data-controller="change-stage-modal">
  <table class="table table-hover tablesorter">
    <thead>
      <tr>
        <th scope="col" class="text-center text-nowrap">
          <span class="d-inline-flex align-items-center gap-1"><%= _('Version') %><%= paginable_sort_link('plans.belnet_version') %></span>
        </th>
        <th scope="col" class="text-nowrap"><%= _('Version Date') %></th>
        <th scope="col" class="text-center sorter-false"><%= _('Reason For Version') %></th>
        <th scope="col" class="text-center text-nowrap sorter-false"><%= _('Answered') %></th>
        <th scope="col" class="text-center text-nowrap sorter-false"><%= _('Stage') %></th>
        <th scope="col" class="text-center text-nowrap sorter-false"><%= _('Actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% scope.each do |plan_version| %>
        <tr data-plan-version-id="<%= plan_version.id %>">
          <td class="text-nowrap text-center">
            <%= plan_version.belnet_version %>
          </td>
          <td class="text-nowrap" data-toggle="tooltip" title="<%= l plan_version.created_at, format: :long %>">
            <%= l plan_version.created_at, format: :long %>
          </td>
          <td title="<%= plan_version.belnet_reason %>">
            <%= plan_version.belnet_reason %>
          </td>
          <td>
            <%= "#{plan_version.num_answered_questions}/#{plan_version.num_questions} (#{plan_version.percent_answered.to_i}%)" %>
          </td>
          <td class="text-center text-nowrap align-middle">
            <%= button_to plan_version.belnet_stage.humanize,
              update_stage_plan_path(plan_version),
              class: "btn btn-secondary w-100 color-white dropdown-toggle",
              data: { action: "change-stage-modal#open",
                plan_id: plan_version.id,
                plan_path: update_stage_plan_path(plan_version), 
                stage_modal_stage_param: plan_version.belnet_stage,
                stage_modal_url_param: update_stage_plan_path(plan_version),
                stage_modal_last_updated_by_param: plan_version.belnet_stage_updated_by&.name || _("Unknown"),
                stage_modal_version_param: plan_version.belnet_version,
                stage_modal_last_updated_at_param: time_ago_in_words(plan_version.updated_at)
              },
              method: :put %>
          </td>
          <td class="text-center text-nowrap">
            <%= link_to _('View'), plan_path(plan_version), class: "dmp_table_link" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="modal fade" data-change-stage-modal-target="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        
        <%= form_with method: :put, data: { change_stage_modal_target: "form" } do |f| %>
          <div class="modal-body">
            <p data-change-stage-modal-target="versionNumber"></p>
            <p class="alert alert-primary mb-3">
              <%= _("Select the new stage for this version of the DMP.") %>
            </p>
            <div class="form-control d-flex flex-column gap-2">
              <select class="form-select" 
                      name="belnet_stage" 
                      data-change-stage-modal-target="stageSelect" 
                      required>
                <option value="" disabled><%= _("Select a Stage...") %></option>
                <% Plan.belnet_stages.keys.each do |stage| %>
                  <option value="<%= stage %>"><%= stage.humanize %></option>
                <% end %>
              </select>
              <p data-change-stage-modal-target="lastUpdatedBy" class="mb-0"></p>

            </div>
          </div>
          
          <div class="d-flex justify-content-end gap-1 modal-footer">
            <button type="button" 
                    class="btn btn-default" 
                    data-action="click->change-stage-modal#close">
              <%= _('Cancel') %>
            </button>
            <button type="submit" class="btn btn-primary">
              <%= _('Update Stage') %>
            </button>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>