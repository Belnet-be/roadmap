<% title _('API v1') %>
<div class="row">
  <div class="col-md-12">
    <h1><%= _('Help') %></h1>
  </div>
</div>


<% content_for :help_tab_body do %>
  <div class="changelog-container">
    <%= render_markdown('belnet/help/reference.md') %>
  </div>
<% end %>

<% content_for :help_ref_tab_body do %>
  <div class="changelog-container">
    <%= render_markdown('belnet/help/api_reference.md') %>
  </div>
<% end %>

<% content_for :help_ref_api_tab_body do %>
  <div class="changelog-container">
    <%= render partial: 'help_api_v1' %>
  </div>
<% end %>

<%= render partial: 'help_navigation' %>
        <div class="row">
          <div class="col-md-12">
            <%= render partial: 'help_ref_navigation' %>
                    <div class="row">
                      <div class="col-md-12">
                        <%= render partial: 'help_ref_api_navigation' %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
