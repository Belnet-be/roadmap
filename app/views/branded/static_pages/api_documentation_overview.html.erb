<% title _('API Documentation') %>
<div class="row">
  <div class="col-md-12">
    <h1><%= _('DMPonline API Documentation') %></h1>
  </div>
</div>


<% content_for :api_documentation_tab_body do %>
  <h2>
    <%= _("API Documentation") %>
  </h2>
  <div class="row">
  <div class="col-md-12">
    <div class="card mb-4">
      <div class="card-header">
        <h2 class="fontsize-h3 mb-0"><%= _('Introduction') %></h2>
      </div>
      <div class="card-body">
        <p><%= _('DMPonline provides a suite of APIs to allow external systems to interact with the platform. This document outlines the available endpoints, the authentication process, and guidelines for testing these APIs using Postman.') %></p>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header">
        <h2 class="fontsize-h3 mb-0"><%= _('Prerequisites') %></h2>
      </div>
      <div class="card-body">
        <p><%= _('To facilitate testing and development, we recommend using an API client.') %></p>
        <ul>
          <li><%= _('Postman: A free application that simplifies making API calls.') %></li>
        </ul>
        <p><%= _('Download Postman here:') %> <%= link_to 'https://www.postman.com/downloads/', 'https://www.postman.com/downloads/', target: '_blank' %></p>
      </div>
    </div>
  </div>
</div>

<% end %>

<%= render partial: 'api_navigation' %>
