<% title _('Version Information') %>
<div class="row mt-5">
  <div class="col-md-12">
    <h1><%= _('Technical Version & Release Information') %></h1>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="card mb-4">
      <div class="card-header">
        <h2 class="fontsize-h3 mb-0"><%= _('Application Information') %></h2>
      </div>
      <div class="card-body">
        <dl class="row">
          <dt class="col-sm-3"><%= _('Application Name') %>:</dt>
          <dd class="col-sm-9"><%= ApplicationService.application_name %></dd>

          <dt class="col-sm-3"><%= _('Provider') %>:</dt>
          <dd class="col-sm-9"><%= Rails.configuration.x.organisation.name %></dd>

          <dt class="col-sm-3"><%= _('Application Version') %>:</dt>
          <dd class="col-sm-9"><%= @app_version %></dd>
          
          <dt class="col-sm-3"><%= _('Ruby Version') %>:</dt>
          <dd class="col-sm-9"><%= @ruby_version %></dd>
          
          <dt class="col-sm-3"><%= _('Rails Version') %>:</dt>
          <dd class="col-sm-9"><%= @rails_version %></dd>

          <dt class="col-sm-3"><%= _('Last Deployment') %>:</dt>
          <dd class="col-sm-9"><%= @build_date %></dd>
        </dl>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header">
        <h2 class="fontsize-h3 mb-0"><%= _('JavaScript Dependencies') %></h2>
      </div>
      <div class="card-body">
        <div>
          <table class="table table-striped table-sm">
            <thead class="table-light sticky-top">
              <tr>
                <th><%= _('Package Name') %></th>
                <th><%= _('Version') %></th>
              </tr>
            </thead>
            <tbody>
              <% @js_dependencies.each do |dep| %>
                <tr>
                  <td><code><%= dep[:name] %></code></td>
                  <td><code><%= dep[:version] %></code></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header">
        <h2 class="fontsize-h3 mb-0"><%= _('Gems') %></h2>
      </div>
      <div class="card-body">
        <div>
          <table class="table table-striped table-sm">
            <thead class="table-light sticky-top">
              <tr>
                <th><%= _('Gem Name') %></th>
                <th><%= _('Version') %></th>
              </tr>
            </thead>
            <tbody>
              <% @gems.each do |gem| %>
                <tr>
                  <td><code><%= gem[:name] %></code></td>
                  <td><code><%= gem[:version] %></code></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>


