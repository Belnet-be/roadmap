<ul class="nav nav-tabs" role="tablist">
  <li role="presentation"
      class="nav-item <%= active_page?(help_reference_path, exact_match: true) ? 'active' : '' %>">
    <%= link_to _('Overview'),
                help_reference_path,
                role: 'tab',
                aria: { controls: 'sub-content' },
                class: 'nav-link' %>
  </li>
  <li role="presentation"
      class="nav-item <%= active_page?(help_reference_api_path) ? 'active' : '' %>">
    <%= link_to _('API Reference'),
                help_reference_api_path,
                role: 'tab',
                aria: { controls: 'sub-content' },
                class: 'nav-link' %>
  </li>
  <li role="presentation"
      class="nav-item <%= active_page?(help_reference_tech_stack_path) ? 'active' : '' %>">
    <%= link_to _('Technology stack'),
                help_reference_tech_stack_path,
                role: 'tab',
                aria: { controls: 'sub-content' },
                class: 'nav-link' %>
  </li>
</ul>
<div class="tab-content">
  <div id="sub-content" role="tabpanel" class="tab-pane active">
    <div class="card card-default">
      <div class="card-body">
        <%= yield :help_ref_tab_body %>


