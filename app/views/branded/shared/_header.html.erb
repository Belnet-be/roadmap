<% title "#{plan.title} - #{title_suffix}" %>
<div data-controller="confirm-modal">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1><%= plan.title %></h1>
          <% if plan.belnet_version == 0 %>
            <h4 class="fs-5"><%= _('LIVE version') %></h4>
          <% else %>
            <h4 class="fs-5">Version <%= plan.belnet_version %></h4>
          <% end %>
        </div>
        <div class="d-flex gap-2">
          <% if plan.readable_by?(current_user.id) && plan.plan_versions_with_live_version.any? %>
            <div class="dropdown">
              <a href="#" class="dropdown-toggle align-center btn btn-secondary text-white" role="button" id="reference-menu" data-bs-toggle="dropdown" data-bs-display="static" aria-haspopup="true" aria-expanded="false">
                <%= _("Compare") %>
                <span class="caret"></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end" 
                  aria-labelledby="reference-menu">
                <% plan.plan_versions_with_live_version.each do |version| %>
                  <li>
                    <%= link_to version.is_plan_live_version? ? _('LIVE') : version.belnet_version, diff_show_plan_path(head_plan: version, base_plan: plan), class: "dropdown-item #{'active' if version == plan}" %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <% if plan.editable_by?(current_user.id) && !plan.is_plan_live_version? %>
            <%= link_to "Edit", plan_path(plan.belnet_family_id), class: "btn btn-secondary" %>
          <% end %>
          <% if plan.submittable_by?(current_user.id) %>
            <%= button_to _("Create Version (V#{plan.latest_belnet_version + 1})"), 
                          create_new_version_plan_path(plan), 
                          method: :post, 
                          class: "btn btn-primary",
                          data: { action: "click->confirm-modal#confirm" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% if plan.submittable_by?(current_user.id) %>
    <div class="modal fade" 
        data-confirm-modal-target="modal" 
        tabindex="-1" 
        role="dialog">
      <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
          <div class="modal-body">
            <p><%= _('Reason for version') %> <strong><%= plan.latest_belnet_version + 1 %></strong>:</p>
            <p class="alert alert-primary"><%= _("Use versioning to mark important milestones in your DMP. Please add a brief description of the changes or the stage reached, to follow this DMP's history. Please avoid excessive versioning for optimal workspace and storage management.") %></p>
            <div class="form-control d-flex flex-column gap-2">
              
              <label for="version_reason" class="form-label fw-bold mb-0"><%= _('Version Description') %></label>
              <textarea id="version_reason"
                        class="form-control" 
                        rows="5" 
                        required
                        data-confirm-modal-target="input"
                        placeholder="<%= _('Provide a description... (10-500 characters)') %>"
                        minlength="10"
                        maxlength="500"></textarea>
              
              <p class="alert alert-primary mb-0 mt-2"><%= _("You can choose to change the stage for this new version, if not, it will remain the stage of your last version, this can be updated at anytime in the History tab.") %></p>
              
              <label for="version_stage" class="form-label fw-bold mb-0"><%= _('Plan Stage') %></label>
              <% stages = plan.org.belnet_stages %>
              <select id="version_stage"
                      class="form-select" 
                      data-confirm-modal-target="stage"
                      required
                      <%= 'disabled' if stages.empty? %>>
                
                <% if stages.empty? %>
                  <option value="" disabled selected>
                    <%= _("No stages available for your organization") %>
                  </option>
                <% else %>
                  <option value="" disabled <%= 'selected' if plan.belnet_stage_id.blank? %>>
                    <%= _("Select a Stage...") %>
                  </option>
                  
                  <% stages.each do |stage| %>
                    <option value="<%= stage.id %>" <%= 'selected' if plan.plan_versions.any? && plan.plan_versions.last.belnet_stage_id == stage.id %>>
                      <%= stage.description %>
                    </option>
                  <% end %>
                <% end %>
                
              </select>
              <div data-confirm-modal-target="errorMessage" class="text-danger d-none" style="margin-top: 5px;">
                <ul class="mb-0 ps-3">
                  <li data-confirm-modal-target="reasonError" class="d-none">
                    <%= _('Reason must be between 10 and 500 characters.') %>
                  </li>
                  <li data-confirm-modal-target="stageError" class="d-none">
                    <%= _('Stage is required.') %>
                  </li>
                </ul>
              </div>
            </div>
          </div>
          <div class="modal-footer justify-content-between">
            <p><%= _("Don't forget to save your changes before creating a version!") %></p>
            <div>
              <button type="button" 
                      class="btn btn-default" 
                      data-action="click->confirm-modal#close">
                <%= _('Cancel') %>
              </button>
              <button type="submit" 
                      class="btn btn-primary" 
                      data-action="confirm-modal#submitWithReason"
                      <%= 'disabled' if stages.empty? %>>
                <%= _('Create Version') %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>