<div class="tab-panels" role="tabpanel">
  <div id="phase-<%= plan.id %>-<%= phase.id %>-panel"
       class="tab-panel active answering-phase"
       aria-hidden="false"
       aria-labelledby="phase-<%= plan.id %>-<%= phase.id %>-tab">
    <div class="row">
      <div class="col-md-8">
        <div class="row">
          <div class="col-md-8">
            <div id="sections-accordion-controls-<%= plan.id %>">
              <div class="accordion-controls px-1" data-parent="sections-accordion-group">
                <a href="#" data-toggle-direction="show"><%= _('expand all') %></a>
                <span>|</span>
                <a href="#" data-toggle-direction="hide"><%= _('collapse all') %></a>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div id="progress-data-<%= plan.id %>"
                 data-sections="<%= sections_info(plan).to_json %>"
                 data-remove="<%= remove_list(plan).to_json %>">
            </div>
            <% if plan.present? && phase.present? %>
              <div class="progress">
                <%= render partial: "/plans/progress",
                           locals: { plan: plan, current_phase: phase } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="accordion sections-accordion-group"
         id="sections-accordion-<%= plan.id %>"
         role="tablist"
         aria-multiselectable="true">
      <% phase.sections.sort { |a, b| a.number <=> b.number }.each do |section| %>
        <% heading_id = "heading-#{plan.id}-#{section.id}" %>
        <% collapse_id = "collapse-#{plan.id}-#{section.id}" %>
        <div class="accordion-item w-100 my-3">
          <h2 class="accordion-header" role="tab" id="<%= heading_id %>">
            <button class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-parent="#sections-accordion-<%= plan.id %>"
                    data-bs-target="#<%= collapse_id %>"
                    aria-expanded="false"
                    aria-controls="<%= collapse_id %>">
              <%= section.title %>
              <% if plan.present? %>
                <span class="section-progress-<%= plan.id %>-<%= section.id %>">
                  <%= render partial: "/org_admin/sections/progress",
                             locals: { section: section, plan: plan } %>
                </span>
              <% end %>
            </button>

          </h2>

          <div id="<%= collapse_id %>"
               class="accordion-collapse collapse"
               role="tabpanel"
               aria-labelledby="<%= heading_id %>"
               data-bs-parent="#sections-accordion-<%= plan.id %>">
            <div class="accordion-body card card-body"><!-- accordion-body -->
              <div class="section-description">
                <div class="display-readonly-textarea-content">
                  <%= sanitize section.description %>
                </div>
              </div>
              <!-- the section body -->
              <% section.questions.each_with_index do |question, i| %>
                <% # Load the answer or create a new one
                  answer = answers[question.id] if plan.present?
                  if answer.blank?
                    answer = Answer.new({ plan: plan, question: question })
                  end
                %>
                <div class="question-body">
                  <div class="question-section">
                    <!-- Answer Section -->
                    <div class="question-form">
                      <div id="<%= "answer-locking-#{plan.id}-#{question.id}" %>"
                        class="answer-locking">
                      </div>
                      <div id="<%= "answer-form-#{plan.id}-#{question.id}" %>" class="answer-form">
                        <%= render(partial: '/answers/new_edit',
                                   locals: { template: phase.template,
                                             question: question,
                                             answer: answer,
                                             readonly: readonly,
                                             locking: false,
                                             base_template_org: base_template_org }) %>
                      </div>
                      <div id="<%= "answer-status-#{plan.id}-#{question.id}" %>" class="mt-10">
                        <%= render(partial: '/answers/status',
                                   locals: { answer: answer }) %>
                      </div>
                    </div>
                  </div>
                </div>
                <% if i != section.questions.length - 1 %>
                  <hr />
                <% end %>
              <% end %> <!-- section.questions.each do -->
            </div> <!-- accordion-body -->
          </div> <!-- accordion-collapse -->
        </div> <!-- accordion-item -->
      <% end %>   <!-- phase.sections.sort {|a,b| a.number <=> b.number }.each do -->
    </div> <!-- accordion -->
  </div> <!-- tab card -->
</div> <!-- tab panels -->
