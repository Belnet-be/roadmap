<% title "#{@plan.title}" %>
<div class="row">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center">
      <h1><%= @plan.title %></h1>
      <%= button_to "Submit For Review (Create Version #{@latest_belnet_version + 1})", 
                  create_new_version_plan_path(@plan), 
                  method: :post, 
                  class: "btn btn-primary" %>
    </div>
  </div>
</div>

<% partial = @plan.editable_by?(current_user.id) ? "edit_details" : "show_details" %>

<div class="row">
  <div class="col-md-12">
    <%= render partial: partial, layout: 'navigation',
               locals: { plan: @plan, visibility: @visibility, orgs: @orgs, org_partial: @org_partial } %>
  </div>
</div>
