<% title "#{@plan.title}" %>
<div data-controller="confirm-modal">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1><%= @plan.title %></h1>
        <%= button_to "Submit For Review (Create Version #{@latest_belnet_version + 1})", 
                      create_new_version_plan_path(@plan), 
                      method: :post, 
                      class: "btn btn-primary",
                      data: { action: "click->confirm-modal#confirm" } %>
      </div>
    </div>
  </div>
  <div class="modal fade" 
       data-confirm-modal-target="modal" 
       tabindex="-1" 
       role="dialog">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-body">
          <p><%= _('Reason for version') %> <strong><%= @latest_belnet_version + 1 %></strong>:</p>
          <div class="form-control mb-3">
            <div class="col-lg-12">
              <textarea class="form-control" 
                        rows="5" 
                        data-confirm-modal-target="input"
                        placeholder="<%= _('Provide a reason...') %>"></textarea>
              
              <div data-confirm-modal-target="errorMessage" 
                   class="text-danger d-none" 
                   style="margin-top: 5px;">
                <strong><%= _('A reason is required.') %></strong>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" 
                  class="btn btn-default" 
                  data-action="click->confirm-modal#close">
            <%= _('Cancel') %>
          </button>
          <button type="button" 
                  class="btn btn-primary" 
                  data-action="confirm-modal#submitWithReason">
            <%= _('Submit For Review') %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<% partial = @plan.editable_by?(current_user.id) ? "edit_details" : "show_details" %>

<div class="row">
  <div class="col-md-12">
    <%= render partial: partial, layout: 'navigation',
               locals: { plan: @plan, visibility: @visibility, orgs: @orgs, org_partial: @org_partial } %>
  </div>
</div>
