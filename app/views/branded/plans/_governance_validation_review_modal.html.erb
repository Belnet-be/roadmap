<div class="modal fade" id="review-governance-validation-<%= validation.id %>-modal" tabindex="-1" role="dialog" aria-labelledby="review-governance-validation-<%= validation.id %>-title">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <%= form_with model: [plan, validation], local: true do |f| %>
        <div class="modal-body">
          <p id="review-governance-validation-<%= validation.id %>-title">
            <%= _('Review Topic Validation') %>
          </p>
          
          <p class="alert alert-primary"><%= _('Please review the validation request, update its status, and provide your rationale') %></p>

          <div class="form-control d-flex flex-column gap-2">
            <%= f.label :validation_status, _('Status'), class: 'form-label fw-bold mb-0' %>
            <%= f.select :validation_status,
                         options_for_select(available_validation_statuses.map { |name| [name, name] },
                                            validation.validation_status),
                         { include_blank: _('Select a status') },
                         { class: 'form-select', required: true } %>

            <%= f.label :rationale, _('Rationale'), class: 'form-label fw-bold mb-0 mt-2' %>
            <%= f.text_area :rationale, rows: 4, class: 'form-control' %>

            <%= f.label :conditions, _('Conditions'), class: 'form-label fw-bold mb-0 mt-2' %>
            <%= f.text_area :conditions, rows: 4, class: 'form-control' %>
          </div>
        </div>

        <div class="modal-footer justify-content-end">
          <div>
            <button type="button" class="btn btn-default" data-bs-dismiss="modal"><%= _('Cancel') %></button>
            <%= f.submit _('Save review'), class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>