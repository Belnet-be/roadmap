<h1>Choose the email address to log in with</h1>
<p>Your ORCID record has several verified email addresses. Each email address has its own account.</p>
<%= form_tag({ controller: :selectable_user, action: :update}, { class: "form-horizontal" }) do %>
  <div class="form-control mb-3">
    <% @emails.each_with_index do |email, i| %>
      <% account = @accounts[email] %>
      <div class="form-check">
        <label class="form-check-label">
          <%= radio_button_tag("selectable_user[email]", email, i == 0, class: 'form-check-input') %>
          <% if account %>
            <%= email %> (<%= account.plans.count %> plans)
          <% else %>
            <%= email %>: create a new account
          <% end %>
        </label>
      </div>
    <% end %>
  </div>
  <div class="form-control">
    <div class="col-sm-12">
      <button type="submit" class="btn btn-primary">Sign in</button>
    </div>
  </div>
<% end %>
